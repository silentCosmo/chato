# ==============================================================================
# Helbeku Environment Configuration Template (.env.local.example)
#
# Copy this file to '.env.local' in the project root and fill in the values.
# These variables are required for server-side matchmaking and database operations.
# Do NOT commit '.env.local' to version control (git).
# ==============================================================================

# 1. Firebase Project ID
# ------------------------------------------------------------------------------
# Source: Firebase Console -> Project Settings (Gear Icon) -> General -> Project ID
# Mapped to: "project_id" in the generated service account JSON file.
FIREBASE_PROJECT_ID=helbeku

# 2. Firebase Service Account Client Email
# ------------------------------------------------------------------------------
# Source: Firebase Console -> Project Settings -> Service Accounts -> client_email
# Mapped to: "client_email" in the generated service account JSON file.
FIREBASE_CLIENT_EMAIL=

# 3. Firebase Service Account Private Key
# ------------------------------------------------------------------------------
# Source: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Mapped to: "private_key" in the generated service account JSON file.
# 
# FORMATTING NOTE: 
# Copy the entire private key string, including:
# "-----BEGIN PRIVATE KEY-----\n..." and ending with "\n-----END PRIVATE KEY-----\n"
# Ensure any literal newlines inside the key string are escaped as '\n' when paste into env.
FIREBASE_PRIVATE_KEY=

# 4. Firebase Realtime Database URL
# ------------------------------------------------------------------------------
# Source: Firebase Console -> Realtime Database (left menu) -> URL displayed at top of database tree
# Example: https://helbeku-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=
